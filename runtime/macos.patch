new file mode 100644
index 0000000..5d886a0
--- /dev/null
+++ b/probes/private-listener.c
@@ -0,0 +1,58 @@
+/* Account-free Linux ABI integration fixture: private listener and TCP refusal. */
+#include "linux-syscall.h"
+typedef unsigned short u16;
+typedef unsigned int u32;
+struct address { u16 family, port; u32 host; unsigned char pad[8]; };
+static void fail(void) { syscall6(93, 1, 0, 0, 0, 0, 0); }
+static void check(long value) { if (value < 0) fail(); }
+void _start(void)
+{
+    struct address target = {2, 0xfeff, 0x0100007f, {0}}; /* port65534, 127.0.0.1 */
+    long listener = syscall6(198, 2, 1, 0, 0, 0, 0);
+    check(listener);
+    long alias = syscall6(23, listener, 0, 0, 0, 0, 0);
+    check(alias);
+    struct { u32 events, pad; unsigned long data; } event = {1, 0, 123};
+    long epoll = syscall6(20, 0, 0, 0, 0, 0, 0);
+    check(epoll);
+    check(syscall6(21, epoll, 1, alias, (long)&event, 0, 0));
+    check(syscall6(200, listener, (long)&target, sizeof(target), 0, 0, 0));
+    struct address local = {0};
+    u32 length = sizeof(local);
+    check(syscall6(204, listener, (long)&local, (long)&length, 0, 0, 0));
+    if (length != sizeof(local) || local.family != 2 || local.port != target.port || local.host != target.host) fail();
+    check(syscall6(57, listener, 0, 0, 0, 0, 0));
+    listener = alias; /* alias must share the substituted listener after close */
+    check(syscall6(201, listener, 2, 0, 0, 0, 0));
+    /* Repeated and duplicate binds fail; they must never create TCP fallback. */
+    if (syscall6(200, listener, (long)&target, sizeof(target), 0, 0, 0) >= 0) fail();
+    long second = syscall6(198, 2, 1, 0, 0, 0, 0);
+    check(second);
+    if (syscall6(200, second, (long)&target, sizeof(target), 0, 0, 0) != -98) fail();
+    check(syscall6(57, second, 0, 0, 0, 0, 0));
+    long wildcard = syscall6(198, 2, 1, 0, 0, 0, 0);
+    check(wildcard);
+    struct address denied = target;
+    denied.host = 0;
+    if (syscall6(200, wildcard, (long)&denied, sizeof(denied), 0, 0, 0) != -13) fail();
+    check(syscall6(57, wildcard, 0, 0, 0, 0, 0));
+    static const char ready[] = "private-listener-ready\n";
+    check(syscall6(64, 1, (long)ready, sizeof(ready)-1, 0, 0, 0));
+    if (syscall6(22, epoll, (long)&event, 1, 5000, 0, 0) != 1 || !(event.events & 1)) fail();
+    struct address remote = {0};
+    length = sizeof(remote);
+    long peer = syscall6(202, listener, (long)&remote, (long)&length, 0, 0, 0);
+    check(peer);
+    if (remote.family != 2 || remote.host != target.host) fail();
+    int one = 1;
+    check(syscall6(208, peer, 6, 1, (long)&one, sizeof(one), 0)); /* TCP_NODELAY */
+    length = sizeof(remote);
+    check(syscall6(205, peer, (long)&remote, (long)&length, 0, 0, 0));
+    if (remote.family != 2 || remote.host != target.host) fail();
+    char byte = 0;
+    if (syscall6(63, peer, (long)&byte, 1, 0, 0, 0) != 1 || byte != 'x') fail();
+    check(syscall6(64, peer, (long)&byte, 1, 0, 0, 0));
+    check(syscall6(57, peer, 0, 0, 0, 0, 0));
+    check(syscall6(57, listener, 0, 0, 0, 0, 0));
+    syscall6(93, 0, 0, 0, 0, 0, 0);
+}
