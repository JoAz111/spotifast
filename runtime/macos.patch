+            lstat(path.fileSystemRepresentation, &node) == 0 && S_ISSOCK(node.st_mode) &&
+            node.st_uid == geteuid() && (node.st_mode & 0777) == 0600 &&
+            lstat(parentPath.fileSystemRepresentation, &parent) == 0 && S_ISDIR(parent.st_mode) &&
+            parent.st_uid == geteuid() && (parent.st_mode & 0777) == 0700) {
+            address.sun_family = AF_UNIX;
+            address.sun_len = sizeof(address);
+            memcpy(address.sun_path, bytes.bytes, bytes.length);
+            int descriptor = socket(AF_UNIX, SOCK_STREAM, 0);
+            if (descriptor >= 0) {
+                ready = connect(descriptor, (struct sockaddr *)&address, sizeof(address)) == 0;
