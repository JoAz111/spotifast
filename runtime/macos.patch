--- /dev/null
+++ b/scripts/private_api.py
@@ -0,0 +1,57 @@
+"""Owner-only Unix transport for the unchanged guest's local WebSocket API.
+
+The Linux syscall layer replaces the explicit loopback bind with this inherited
+socket. No TCP control listener is created. Same-user software and root remain
+inside this trust boundary; browser pages cannot open an AF_UNIX socket.
+"""
+from contextlib import contextmanager
+import os
+from pathlib import Path
+import socket
+import stat
+import tempfile
+import websockets
+
+PORT = 65534  # A guest-visible selector only; the host never binds this port.
+
+
+def endpoint(state):
+    hint = state / "ws.socket"
+    info = hint.lstat()
+    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
+        raise ValueError("Private API discovery must be an owner-only regular file")
+    raw = hint.read_text().strip()
+    path = Path(raw)
+    if not path.is_absolute() or len(os.fsencode(raw)) >= 104 or path.is_symlink():
+        raise ValueError("Invalid private API socket path")
+    node, parent = path.lstat(), path.parent.lstat()
+    if not stat.S_ISSOCK(node.st_mode) or node.st_uid != os.getuid() or node.st_mode & 0o777 != 0o600:
+        raise ValueError("Private API requires an owner-only Unix socket")
+    if not stat.S_ISDIR(parent.st_mode) or parent.st_uid != os.getuid() or parent.st_mode & 0o777 != 0o700:
+        raise ValueError("Private API requires an owner-only directory")
+    return raw
+
+
+def connect(state, **options):
+    return websockets.unix_connect(endpoint(state), uri="ws://localhost/", **options)
+
+
+@contextmanager
+def listener(state, publish):
+    with tempfile.TemporaryDirectory(prefix="soloist-control-", dir="/private/tmp") as directory:
+        root = Path(directory)
+        root.chmod(0o700)
+        path = root / "api.sock"
+        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as control:
+            control.bind(str(path))
+            path.chmod(0o600)
+            publish(state / "ws.socket", str(path) + "\n")
+            try:
+                yield control
+            finally:
+                # The receiver lock excludes another receiver; do not remove
+                # a replacement discovery file if an external owner changed it.
+                if (state / "ws.socket").exists() and (state / "ws.socket").read_text().strip() == str(path):
+                    (state / "ws.socket").unlink()
+                for name in ("ws.addr", "ws.port"):
+                    (state / name).unlink(missing_ok=True)
