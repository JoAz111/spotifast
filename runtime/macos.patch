index 0000000..3c025a7
--- /dev/null
+++ b/scripts/test-current-diagnostics.py
@@ -0,0 +1,114 @@
+"""Synthetic current-run retention/privacy fixtures. No account, clipboard or audio use."""
+import contextlib
+import io
+import json
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import AsyncMock, patch
+
+import current_diagnostics as diagnostics
+import private_profile
+import receiver
+import runtime_cli
+
+
+class Tests(unittest.TestCase):
+    def setUp(self):
+        temporary = tempfile.TemporaryDirectory(prefix="soloist-diagnostics-test-", dir="/private/tmp")
+        self.addCleanup(temporary.cleanup)
+        self.root = Path(temporary.name).resolve() / "profile"
+        self.state, self.cache = self.root / "state", self.root / "cache"
+        private_profile.initialize(self.root, self.root, self.state, self.cache)
+        self.session = diagnostics.Session(self.state)
+        self.addCleanup(self.session.close)
+
+    def test_persists_only_allowlisted_pairing_and_audio_evidence(self):
+        with contextlib.redirect_stdout(io.StringIO()):
+            for line in (b"private song / user / token: synthetic-secret",
+                         b"zeroconf: received addUser account=sensitive-account",
+                         b"pairing complete, credentials stored sensitive-session",
+                         b"logged in as sensitive-account",
+                         b"codec: flac private-song",
+                         b"sample rate: 44100 Hz private-device",
+                         b"sample format: S24LE private-device",
+                         b"sample format: synthetic-secret",
+                         b"sample rate: 999999 Hz",
+                         b"client-token: network request error: synthetic-secret, value: 42"):
+                receiver.report(line, b"synthetic-secret", self.session)
+        value = diagnostics.read(self.state)
+        raw = json.dumps(value)
+        for private in ("synthetic", "sensitive", "private-song", "private-device", "value: 42"):
+            self.assertNotIn(private, raw)
+        self.assertTrue(any(item["event"] == "codec" and item["value"] == "flac" for item in value["events"]))
+        self.assertEqual([item["value"] for item in value["events"] if "value" in item], ["flac", 44100, "s24le"])
+        self.assertIsNone(value["logged_in"])
+        self.assertNotEqual(value["phase"], "authenticated")  # A log phrase is insufficient.
+        self.assertEqual((self.state / diagnostics.NAME).stat().st_mode & 0o777, 0o600)
+
+    def test_bounded_tail_and_new_run_resets_previous_evidence(self):
+        for _ in range(diagnostics.MAX_EVENTS + 20):
+            self.session.record("pairing_request")
+        value = diagnostics.read(self.state)
+        self.assertEqual(len(value["events"]), diagnostics.MAX_EVENTS)
+        self.assertEqual(value["dropped_events"], 21)
+        self.assertLess((self.state / diagnostics.NAME).stat().st_size, diagnostics.MAX_BYTES)
+        replacement = diagnostics.Session(self.state)
+        replacement.close()
+        self.assertEqual([item["event"] for item in diagnostics.read(self.state)["events"]], ["run_started"])
+        self.assertEqual(sorted(path.name for path in self.state.iterdir()), [diagnostics.NAME])
+
+    def test_authentication_uses_typed_booleans_only(self):
+        self.session.auth({"logged_in": "true", "is_active": True, "account": "synthetic-account"})
+        self.assertIsNone(diagnostics.read(self.state)["logged_in"])
+        self.session.auth({"logged_in": True, "is_active": True, "account": "synthetic-account"})
+        value = diagnostics.read(self.state)
+        self.assertEqual(value["phase"], "authenticated")
+        self.assertTrue(value["is_active"])
+        self.assertNotIn("synthetic-account", json.dumps(value))
+        self.session.auth({"logged_in": False, "is_active": False})
+        self.assertEqual(diagnostics.read(self.state)["phase"], "waiting_for_pairing")
+
+    def test_read_refuses_links_public_files_and_untrusted_fields(self):
+        path = self.state / diagnostics.NAME
+        outside = self.root.parent / "keep"
+        outside.write_text("synthetic-private-data")
+        path.unlink()
+        path.symlink_to(outside)
+        with self.assertRaises(OSError):
+            diagnostics.read(self.state)
+        self.session.record("pairing_request")  # Replace the link; never follow/write it.
+        self.assertEqual(outside.read_text(), "synthetic-private-data")
+        path.chmod(0o644)
+        with self.assertRaises(diagnostics.DiagnosticError):
+            diagnostics.read(self.state)
+        path.chmod(0o600)
+        value = diagnostics.read(self.state)
+        for invalid in ({**value, "account": "synthetic-private-data"},
+                        {**value, "events": [{"event": "codec", "value": "synthetic-secret", "elapsed_ms": 0}]},
+                        {**value, "phase": "synthetic-private-data"},
+                        {**value, "phase": "authenticated", "logged_in": False},
+                        {**value, "events": [{"event": "pairing_request", "elapsed_ms": 0, "extra": "secret"}]}):
+            path.write_text(json.dumps(invalid))
+            with self.assertRaises(diagnostics.DiagnosticError) as error:
+                diagnostics.read(self.state)
+            self.assertNotIn("synthetic", str(error.exception))
+        path.write_bytes(b"x" * (diagnostics.MAX_BYTES + 1))
+        with self.assertRaises(diagnostics.DiagnosticError):
+            diagnostics.read(self.state)
+
+    def test_safe_cli_reads_only_validated_snapshot_and_logged_out_status_returns_promptly(self):
+        with patch.multiple(runtime_cli, DATA=self.root, RAW_DATA=self.root, STATE=self.state, CACHE=self.cache), \
+                contextlib.redirect_stdout(io.StringIO()) as output:
+            self.assertEqual(runtime_cli.main(["diagnostics"]), 0)
+        self.assertEqual(json.loads(output.getvalue())["phase"], "starting")
+        with patch.object(runtime_cli.client_api, "request", new_callable=AsyncMock,
+                          return_value={"type": "auth_state", "logged_in": False, "is_active": False}) as request, \
+                contextlib.redirect_stdout(io.StringIO()) as output:
+            self.assertEqual(runtime_cli.main(["status"]), 0)
+        request.assert_awaited_once_with("get_auth_state")
+        self.assertFalse(json.loads(output.getvalue())["logged_in"])
+
+
+if __name__ == "__main__":
+    unittest.main()
