new file mode 100644
index 0000000..0735959
--- /dev/null
+++ b/scripts/test-credentials.py
@@ -0,0 +1,74 @@
+"""Credential fixtures use synthetic values and never open the native store."""
+import ctypes
+from types import SimpleNamespace
+from unittest import TestCase, main
+from unittest.mock import Mock, patch
+import credentials
+
+
+class FakeAPI:
+    def __init__(self, *, matching=0, updates=(0,), addition=0):
+        self.queries = []
+        self._sec = SimpleNamespace(SecItemUpdate=Mock(side_effect=updates))
+        self._found = SimpleNamespace(CFDataCreate=Mock(return_value=123), CFRelease=Mock())
+        self.SecItemCopyMatching = Mock(return_value=matching)
+        self.SecItemAdd = Mock(return_value=addition)
+        self.k_ = lambda name: name
+
+    def create_query(self, **values):
+        self.queries.append(values)
+        return len(self.queries) + 1000
+
+
+class Tests(TestCase):
+    def test_presence_requests_no_secret_or_attributes_and_never_prompts(self):
+        api = FakeAPI()
+        self.assertTrue(credentials._macos_exists(api))
+        query = api.queries[0]
+        self.assertEqual(query['kSecAttrService'], credentials.SERVICE)
+        self.assertEqual(query['kSecAttrAccount'], credentials.ACCOUNT)
+        self.assertEqual(query['kSecUseAuthenticationUI'], 'kSecUseAuthenticationUIFail')
+        self.assertFalse(any(key.startswith('kSecReturn') for key in query))
+        self.assertIsNone(api.SecItemCopyMatching.call_args.args[1])
+        api._found.CFRelease.assert_called_once()
+
+    def test_only_item_not_found_is_reported_as_missing(self):
+        self.assertFalse(credentials._macos_exists(FakeAPI(matching=-25300)))
+        for status in (-128, -25293, -25308, -50):
+            with self.subTest(status=status), self.assertRaises(credentials.CredentialError):
+                credentials._macos_exists(FakeAPI(matching=status))
+
+    def test_replacement_updates_in_place_and_uses_cfdata_pointer(self):
+        api = FakeAPI()
+        credentials._macos_save('synthetic-key', api)
+        api._sec.SecItemUpdate.assert_called_once()
+        api.SecItemAdd.assert_not_called()
+        self.assertIsInstance(api.queries[1]['kSecValueData'], ctypes.c_void_p)
+        buffer = api._found.CFDataCreate.call_args.args[1]
+        self.assertEqual(bytes(buffer), b'\0' * len(buffer))
+
+    def test_failed_update_never_adds_or_deletes(self):
+        api = FakeAPI(updates=(-25293,))
+        with self.assertRaises(credentials.CredentialError):
+            credentials._macos_save('synthetic-key', api)
+        api.SecItemAdd.assert_not_called()
+        self.assertEqual(api._found.CFRelease.call_count, 3)
+
+    def test_first_save_adds_and_concurrent_first_save_retries_update(self):
+        api = FakeAPI(updates=(-25300,))
+        credentials._macos_save('synthetic-key', api)
+        api.SecItemAdd.assert_called_once()
+        api = FakeAPI(updates=(-25300, 0), addition=-25299)
+        credentials._macos_save('synthetic-key', api)
+        self.assertEqual(api._sec.SecItemUpdate.call_count, 2)
+
+    def test_read_failure_has_fixed_credential_safe_message(self):
+        with patch.object(credentials, 'backend') as backend:
+            backend.return_value.get_password.side_effect = RuntimeError('synthetic-private-text')
+            with self.assertRaises(credentials.CredentialError) as error:
+                credentials.load()
+        self.assertNotIn('synthetic-private-text', str(error.exception))
+
+
+if __name__ == '__main__':
+    main()
