diff --git a/scripts/current_diagnostics.py b/scripts/current_diagnostics.py
new file mode 100644
index 0000000..f8a5b23
--- /dev/null
+++ b/scripts/current_diagnostics.py
@@ -0,0 +1,205 @@
+"""Bounded current-run diagnostics. Never persist raw engine output or metadata."""
+import json
+import os
+import re
+import secrets
+import stat
+import time
+
+import private_profile
+
+NAME = "receiver-diagnostics.json"
+MAX_EVENTS = 64
+MAX_BYTES = 32768
+PHASES = {"starting", "waiting_for_pairing", "authenticated", "unresponsive", "stopped", "error"}
+MARKERS = {
+    "mdns created successfully": "discovery_ready",
+    "Failed to initialize mdns": "discovery_failed",
+    "zeroconf: received addUser": "pairing_request",
+    "pairing complete, credentials stored": "pairing_complete",
+    "logged in as ": "engine_signed_in",
+    "Using PulseAudio": "native_output_selected",
+    "login failed": "login_failed",
+    "session_auth_info_not_found": "session_auth_info_missing",
+    "certificate verify failed": "tls_certificate_failed",
+    "first message received, connection established": "cloud_connected",
+    "became active device": "device_active",
+    "no longer active device": "device_inactive",
+    "Failed to create decompressor": "decoder_failed",
+    "websocket: received error:": "cloud_error",
+    "API key": "api_key_configuration_mentioned",
+    "client-token: Forbidden": "client_token_forbidden",
+    "client-token: unexpected response": "client_token_response_failed",
+    "client-token: unparsable": "client_token_parse_failed",
+    "decryption failed or bad record mac": "tls_record_failed",
+    "No valid session info after login completion": "session_info_missing",
+    "Invalid user credentials": "credentials_rejected",
+    "Forced logout received for session:": "server_logout",
+    "Session creation from stored credentials failed": "stored_session_failed",
+    "Session creation via Connect failed": "connect_session_failed",
+    "Connect session creation failed": "connect_session_failed",
+    "ConnectZeroconfLoginProtocol::login: failed": "zeroconf_login_failed",
+    "client-token: cannot fulfill a request": "client_token_request_failed",
+    "client-token: network request error": "client_token_network_failed",
+    "client-token: non-succesful HTTP status code returned": "client_token_http_failed",
+}
+CODES = set(MARKERS.values()) | {"run_started", "session_started", "discovery_service_started",
+        "integrity_preflight", "integrity_exit", "health_failed", "startup_failed", "run_stopped"}
+CODECS = {"flac", "vorbis", "ogg", "aac", "mp3"}
+FORMATS = {"s16le", "s16be", "s24le", "s24be", "s24-32le", "s24-32be", "s32le", "s32be",
+           "float32le", "float32be", "f32le", "f32be", "s16", "s24", "s32", "float32", "u8"}
+
+
+class DiagnosticError(ValueError):
+    """Only fixed messages; never include untrusted file contents."""
+
+
+def _integer(value, maximum=2**53 - 1):
+    return type(value) is int and 0 <= value <= maximum
+
+
+def validate(value):
+    """Reject unknown fields and values before exposing a private snapshot."""
+    fields = {"schema", "supervisor_pid", "phase", "logged_in", "is_active", "events", "dropped_events", "elapsed_ms"}
+    if type(value) is not dict or set(value) != fields or type(value["schema"]) is not int or value["schema"] != 1:
+        raise DiagnosticError("Current-run diagnostic schema is invalid")
+    if value["phase"] not in PHASES or any(value[key] is not None and type(value[key]) is not bool
+                                         for key in ("logged_in", "is_active")):
+        raise DiagnosticError("Current-run diagnostic state is invalid")
+    if not _integer(value["supervisor_pid"], 2**31 - 1) or value["supervisor_pid"] == 0 \
+            or value["phase"] == "authenticated" and value["logged_in"] is not True:
+        raise DiagnosticError("Current-run diagnostic identity or authentication state is invalid")
+    if not _integer(value["elapsed_ms"]) or not _integer(value["dropped_events"]):
+        raise DiagnosticError("Current-run diagnostic bounds are invalid")
+    events = value["events"]
+    if type(events) is not list or len(events) > MAX_EVENTS:
+        raise DiagnosticError("Current-run diagnostic event bounds are invalid")
+    for event in events:
+        if type(event) is not dict or set(event) not in ({"event", "elapsed_ms"}, {"event", "elapsed_ms", "value"}):
+            raise DiagnosticError("Current-run diagnostic event schema is invalid")
+        if not _integer(event["elapsed_ms"]):
+            raise DiagnosticError("Current-run diagnostic event time is invalid")
+        code = event["event"]
+        if "value" not in event:
+            valid = type(code) is str and code in CODES
+        elif code == "codec":
+            valid = type(event["value"]) is str and event["value"] in CODECS
+        elif code == "sample_format":
+            valid = type(event["value"]) is str and event["value"] in FORMATS
+        elif code == "sample_rate_hz":
+            valid = type(event["value"]) is int and 8000 <= event["value"] <= 768000
+        else:
+            valid = False
+        if not valid:
+            raise DiagnosticError("Current-run diagnostic event value is invalid")
+    return value
+
+
+def _open_state(state, expected=None):
+    previous = expected or private_profile.private_directory(state)
+    descriptor = os.open(state, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+    info = os.fstat(descriptor)
+    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o777 != 0o700 \
+            or (info.st_dev, info.st_ino) != (previous.st_dev, previous.st_ino):
+        os.close(descriptor)
+        raise DiagnosticError("Private diagnostic directory changed")
+    return descriptor
+
+
+def read(state, expected=None):
+    directory = _open_state(state, expected)
+    try:
+        descriptor = os.open(NAME, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
+        with os.fdopen(descriptor, "rb") as stream:
+            info = os.fstat(stream.fileno())
+            if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o777 != 0o600:
+                raise DiagnosticError("Current-run diagnostics must be an owner-only regular file")
+            raw = stream.read(MAX_BYTES + 1)
