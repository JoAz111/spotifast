+        NSString *deviceID = ReceiverDeviceID(state);
+        [environment removeObjectForKey:@"SPOTIFAST_SOLOIST_DEVICE_ID"];
+        if (deviceID) environment[@"SPOTIFAST_SOLOIST_DEVICE_ID"] = deviceID;
