+- (void)refreshReceiverStatus:(NSTask *)receiver {
+    if (self.task != receiver || !receiver.running || self.stopping) return;
+    // Read the helper's strict private snapshot, without another engine query.
+    NSTask *check = [NSTask new];
+    check.executableURL = self.helper;
+    check.arguments = @[@"diagnostics"];
+    NSPipe *output = [NSPipe pipe];
+    check.standardOutput = output;
+    check.standardError = [NSFileHandle fileHandleWithNullDevice];
+    void (^again)(void) = ^{
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 5 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+            [self refreshReceiverStatus:receiver];
+        });
+    };
+    check.terminationHandler = ^(NSTask *finished) {
+        NSData *data = [output.fileHandleForReading readDataToEndOfFile];
+        NSDictionary *reply = data ? [NSJSONSerialization JSONObjectWithData:data options:0 error:nil] : nil;
+        dispatch_async(dispatch_get_main_queue(), ^{
+            if (self.task != receiver || !receiver.running || self.stopping) return;
+            if (finished.terminationStatus == 0 && [reply isKindOfClass:NSDictionary.class] &&
+                [reply[@"supervisor_pid"] intValue] == receiver.processIdentifier) {
+                NSString *phase = reply[@"phase"];
+                if ([phase isEqualToString:@"authenticated"])
+                    self.status.stringValue = @"Spotify Connect authenticated. Choose music in Spotifast. Closing this app stops the receiver.";
+                else if ([phase isEqualToString:@"waiting_for_pairing"])
+                    self.status.stringValue = [NSString stringWithFormat:@"Waiting for pairing. Select “%@” in Spotify Connect and play a song using the same Spotify account as Spotifast.", self.deviceName.stringValue];
+                else if ([phase isEqualToString:@"unresponsive"])
+                    self.status.stringValue = @"Receiver is running; its local status is temporarily unavailable. Checking again…";
+                else if ([phase isEqualToString:@"error"])
+                    self.status.stringValue = @"Receiver reported an error. The bundled diagnostics command has private pairing and codec evidence.";
+            }
+            again();
+        });
+    };
+    if (![check launchAndReturnError:nil]) {
+        again();
+        return;
+    }
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 5 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+        if (check.running) [check terminate];
+    });
+}
+- (void)awaitFrontend:(NSTask *)receiver remaining:(NSInteger)remaining {
