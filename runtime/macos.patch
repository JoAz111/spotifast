new file mode 100644
index 0000000..00257b6
--- /dev/null
+++ b/scripts/test-private-api.py
@@ -0,0 +1,73 @@
+"""Account-free Unix transport, permissions and Linux ABI integration checks."""
+import os
+from pathlib import Path
+import selectors
+import socket
+import subprocess
+import tempfile
+import unittest
+import private_api
+from receiver import private_text
+from paths import ROOT, RUNTIME
+
+
+class Tests(unittest.TestCase):
+    def test_permission_validation_and_cleanup(self):
+        with tempfile.TemporaryDirectory() as directory:
+            state = Path(directory)
+            with private_api.listener(state, private_text) as control:
+                path = Path(private_api.endpoint(state))
+                self.assertLess(len(os.fsencode(path)), 104)
+                self.assertEqual(path.stat().st_mode & 0o777, 0o600)
+                self.assertEqual(path.parent.stat().st_mode & 0o777, 0o700)
+                path.chmod(0o666)
+                with self.assertRaises(ValueError):
+                    private_api.endpoint(state)
+                path.chmod(0o600)
+                path.parent.chmod(0o755)
+                with self.assertRaises(ValueError):
+                    private_api.endpoint(state)
+                path.parent.chmod(0o700)
+                (state / "ws.socket").chmod(0o644)
+                with self.assertRaises(ValueError):
+                    private_api.endpoint(state)
+                self.assertGreater(control.fileno(), 2)
+            self.assertFalse(path.exists())
+            self.assertFalse((state / "ws.socket").exists())
+
+    def test_no_tcp_fallback_and_guest_socket_abi(self):
+        # Avoid claiming a no-listener result if another service already uses
+        # the selected port. It is never reserved by our compatibility runtime.
+        with socket.socket() as probe:
+            self.assertNotEqual(probe.connect_ex(("127.0.0.1", private_api.PORT)), 0)
+        linker = Path(subprocess.check_output(["rustc", "--print", "sysroot"], text=True).strip()) / "lib/rustlib/aarch64-apple-darwin/bin/gcc-ld/ld.lld"
+        obj, elf = ROOT / "build/private-listener.o", ROOT / "build/private-listener.elf"
+        subprocess.run(["xcrun", "clang", "--target=aarch64-linux-gnu", "-O1", "-ffreestanding", "-fno-stack-protector", "-Wall", "-Wextra", "-Werror", "-c", str(ROOT / "probes/private-listener.c"), "-o", str(obj)], check=True)
+        subprocess.run([str(linker), "-e", "_start", "-z", "max-page-size=65536", str(obj), "-o", str(elf)], check=True)
+        with tempfile.TemporaryDirectory() as directory:
+            state = Path(directory)
+            with private_api.listener(state, private_text) as control:
+                command = [str(RUNTIME), "--no-rosetta", "--clear-env", "--private-tcp-listener", str(private_api.PORT), str(control.fileno()), "--", str(elf)]
+                process = subprocess.Popen(command, pass_fds=(control.fileno(),), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+                try:
+                    with selectors.DefaultSelector() as selector:
+                        selector.register(process.stdout, selectors.EVENT_READ)
+                        self.assertTrue(selector.select(15), "guest fixture failed to become ready")
+                    self.assertEqual(process.stdout.readline(), b"private-listener-ready\n")
+                    with socket.socket() as tcp:
+                        self.assertNotEqual(tcp.connect_ex(("127.0.0.1", private_api.PORT)), 0)
+                    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as unix:
+                        unix.settimeout(5)
+                        unix.connect(private_api.endpoint(state))
+                        unix.sendall(b"x")
+                        self.assertEqual(unix.recv(1), b"x")
+                    stdout, stderr = process.communicate(timeout=10)
+                    self.assertEqual(process.returncode, 0, "fixture failed; no private data involved: " + stderr.decode(errors="replace"))
+                finally:
+                    if process.poll() is None:
+                        process.kill()
+                        process.communicate()
+
+
+if __name__ == "__main__":
+    unittest.main()
