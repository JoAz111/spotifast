+            styleMask:NSWindowStyleMaskBorderless backing:NSBackingStoreBuffered defer:YES];
+        FixtureSecureEditor *editor = [[FixtureSecureEditor alloc] initWithFrame:NSMakeRect(0,0,200,100)];
+        [app.fixtureWindow.contentView addSubview:editor];
+        if (![app.fixtureWindow makeFirstResponder:editor]) return 1;
+        app.mainMenu = StandardMainMenu();
+        NSMenu *edit = [app.mainMenu itemAtIndex:1].submenu;
+        NSMenuItem *paste = [edit itemWithTitle:@"Paste"];
+        if (paste.target || paste.action != @selector(paste:) || ![paste.keyEquivalent isEqualToString:@"v"])
