+/* Offscreen native shortcut routing fixture. Never reads the system clipboard or Keychain. */
+#define main launcher_application_main
+#include "../packaging/launcher.m"
+#undef main
+
+@interface FixtureApplication : NSApplication
+@property NSWindow *fixtureWindow;
+@end
+@implementation FixtureApplication
+- (NSWindow *)keyWindow { return self.fixtureWindow; }
+- (NSWindow *)mainWindow { return self.fixtureWindow; }
+@end
+
+@interface FixtureSecureEditor : NSSecureTextField
+@property BOOL pasted;
+@end
+@implementation FixtureSecureEditor
+- (BOOL)becomeFirstResponder { return YES; }
+- (void)paste:(id)sender {
+    (void)sender;
+    self.pasted = YES;
+    self.stringValue = @"dummy-menu-fixture";
+}
+- (BOOL)validateMenuItem:(NSMenuItem *)item {
+    // Test routing only. Do not ask the real clipboard whether paste is available.
+    return item.action == @selector(paste:);
+}
+@end
+
+static void TestReceiverDeviceID(void) {
+    char directory[] = "/private/tmp/spotifast-device-fixture-XXXXXX";
+    NSCAssert(mkdtemp(directory), @"temporary fixture directory");
+    NSURL *root = [NSURL fileURLWithFileSystemRepresentation:directory isDirectory:YES relativeToURL:nil];
+    NSURL *file = [root URLByAppendingPathComponent:@".device_id"];
+    NSString *identifier = @"00000000-0000-0000-0000-000000000000";
+    NSCAssert(!ReceiverDeviceID(root), @"missing identity is unknown");
+    NSCAssert([identifier writeToURL:file atomically:YES encoding:NSASCIIStringEncoding error:nil], @"write fixture");
+    NSCAssert([ReceiverDeviceID(root) isEqualToString:identifier], @"owned public Connect ID is accepted");
+    NSCAssert(chmod(file.fileSystemRepresentation, 0666) == 0, @"set insecure mode");
+    NSCAssert(!ReceiverDeviceID(root), @"writable identity cannot classify a remote device as local");
+    NSCAssert(chmod(file.fileSystemRepresentation, 0600) == 0, @"restore private mode");
+    NSCAssert(chmod(directory, 0755) == 0, @"set directory mode");
+    NSCAssert(!ReceiverDeviceID(root), @"public state directory is rejected");
+    NSCAssert(chmod(directory, 0700) == 0, @"restore private state mode");
+    NSCAssert([@"../other-device" writeToURL:file atomically:YES encoding:NSASCIIStringEncoding error:nil], @"write invalid fixture");
+    NSCAssert(!ReceiverDeviceID(root), @"only a bounded Connect identifier is accepted");
+    NSURL *target = [root URLByAppendingPathComponent:@"target"];
+    NSCAssert([identifier writeToURL:target atomically:YES encoding:NSASCIIStringEncoding error:nil], @"write link target");
+    NSCAssert(unlink(file.fileSystemRepresentation) == 0, @"remove old fixture");
+    NSCAssert(symlink(target.fileSystemRepresentation, file.fileSystemRepresentation) == 0, @"create link fixture");
+    NSCAssert(!ReceiverDeviceID(root), @"symlink identity is rejected");
+    NSCAssert([NSFileManager.defaultManager removeItemAtURL:root error:nil], @"remove only fixture directory");
