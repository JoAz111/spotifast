+"""Rebuild only the launcher/frontend while preserving an approved local helper.
+
+Use this only when the runtime helper has not changed since --base was built.
+The helper's signed bytes and manifest must remain identical, preserving its
+macOS Keychain identity. This does not compile or qualify runtime Python edits.
+"""
+import argparse
+import hashlib
+import importlib.util
+import json
+import plistlib
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parent.parent
+
+def run(*args):
+    subprocess.run([str(arg) for arg in args], check=True)
+
+def helper_hashes(app):
+    helper = app / 'Contents/Helpers/runtime-cli.app'
+    return {str(p.relative_to(helper)): hashlib.sha256(p.read_bytes()).hexdigest()
+            for p in helper.rglob('*') if p.is_file() and not p.is_symlink()}
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--base', type=Path, required=True)
+    parser.add_argument('--frontend', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    args = parser.parse_args()
+    if args.output.exists():
+        parser.error('Output already exists; preserve the previous app')
+    spec = importlib.util.spec_from_file_location('package_audit', ROOT / 'scripts/verify-package.py')
+    verifier = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(verifier)
+    verifier.audit(args.base)
+    original = helper_hashes(args.base)
+    work = Path(tempfile.mkdtemp(prefix='spotifast-refresh-', dir='/private/tmp'))
+    app = work / args.output.name
+    shutil.copytree(args.base, app, symlinks=True)
+    macos = app / 'Contents/MacOS'
+    shutil.copy2(args.frontend, macos / 'Spotifast')
+    (macos / 'Spotifast').chmod(0o755)
+    run('codesign', '--force', '--sign', '-', macos / 'Spotifast')
+    run('xcrun', 'clang', '-fobjc-arc', '-Wall', '-Wextra', '-Werror', '-arch', 'arm64',
+        '-mmacosx-version-min=27.0', '-framework', 'AppKit', '-framework', 'ServiceManagement',
+        ROOT / 'packaging/launcher.m', '-o', macos / 'SoloistRuntime')
+    shutil.copy2(ROOT / 'packaging/QUICKSTART.md', app / 'Contents/Resources/QUICKSTART.md')
+    info_path = app / 'Contents/Info.plist'
+    info = plistlib.loads(info_path.read_bytes())
+    info['CFBundleURLTypes'] = [{'CFBundleURLName': 'local.spotifast.soloist.settings',
+                              'CFBundleURLSchemes': ['spotifast-soloist']}]
+    info_path.write_bytes(plistlib.dumps(info))
+    manifest_path = app / 'Contents/Resources/manifest.json'
+    manifest = json.loads(manifest_path.read_text())
+    manifest['local_frontend_refresh'] = {
+        'runtime_helper_rebuilt': False,
+        'runtime_helper_bytes_preserved': True,
+        'launcher_sha256': hashlib.sha256((ROOT / 'packaging/launcher.m').read_bytes()).hexdigest(),
+        'frontend_sha256': hashlib.sha256((macos / 'Spotifast').read_bytes()).hexdigest(),
+        'frontend_revision': subprocess.check_output(['git', 'rev-parse', 'HEAD'],
+                             cwd=args.frontend.parent.parent.parent, text=True).strip()
+    }
+    manifest_path.write_text(json.dumps(manifest, indent=2) + '\n')
+    for name in ('com.apple.ResourceFork', 'com.apple.FinderInfo'):
+        subprocess.run(['xattr', '-dr', name, str(app)], check=True,
+                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    run('codesign', '--force', '--sign', '-', app)
+    if helper_hashes(app) != original:
+        raise RuntimeError('Signed runtime helper changed; refusing replacement')
+    verifier.audit(app)
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    shutil.move(app, args.output)
+    print('Built local frontend/launcher refresh; approved runtime helper is byte-identical.')
+
+if __name__ == '__main__':
+    main()
