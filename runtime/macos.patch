@@ -0,0 +1,93 @@
+"""Explicitly enrolled private profile; reset never initializes a directory."""
+import json
+import os
+from pathlib import Path
+import stat
+
+from paths import ROOT
+
+MARKER = ".soloist-runtime-profile.json"
+IDENTITY = "spotifast-soloist-private-profile"
+
+
+class ProfileError(ValueError):
+    """Fixed credential-safe validation messages only."""
+
+
+def private_directory(path):
+    info = path.lstat()
+    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o777 != 0o700:
+        raise ProfileError("Private profile directories must be owned by you with mode 700")
+    if path != path.resolve(strict=True):
+        raise ProfileError("Private profile directories must be canonical and contain no symlinks")
+    return info
+
+
+def root_check(data, raw_data):
+    if not data.is_absolute() or raw_data != data or data != data.resolve():
+        raise ProfileError("Private profile root must be an absolute canonical path without symlinks")
+    home = Path.home().resolve()
+    forbidden = {home / name for name in ("Documents", "Downloads", "Desktop", "Library")}
+    forbidden.update({home / "Library/Application Support", Path("/private/tmp"), ROOT, ROOT.parent})
+    if data == home or data in home.parents or data in forbidden or len(data.parts) < 4:
+        raise ProfileError("Choose a dedicated private runtime profile directory")
+
+
+def validate(data, raw_data, state, cache):
+    root_check(data, raw_data)
+    info = private_directory(data)
+    if state != data / "state" or cache != data / "cache":
+        raise ProfileError("Profile state and cache must be direct children of the private root")
+    directories = {path: private_directory(path) for path in (data, state, cache)}
+    marker = data / MARKER
+    descriptor = os.open(marker, os.O_RDONLY | os.O_NOFOLLOW)
+    with os.fdopen(descriptor, "rb") as stream:
+        entry = os.fstat(stream.fileno())
+        if not stat.S_ISREG(entry.st_mode) or entry.st_uid != os.getuid() or entry.st_mode & 0o777 != 0o600:
+            raise ProfileError("Private profile marker must be an owner-only regular file")
+        raw = stream.read(4097)
+    if len(raw) > 4096:
+        raise ProfileError("Private profile marker is invalid")
+    try:
+        record = json.loads(raw)
+    except (ValueError, UnicodeError) as error:
+        raise ProfileError("Private profile marker is invalid") from error
+    if record != {"identity": IDENTITY, "schema": 1, "uid": os.getuid(),
+                  "root": str(data), "device": info.st_dev, "inode": info.st_ino}:
+        raise ProfileError("Private profile marker does not match this initialized directory")
+    return directories
+
+
+def initialize(data, raw_data, state, cache):
+    """Enroll a fresh dedicated root.
+
+    Custom environment paths do not authorize deletion by themselves. Existing
+    unrelated top-level files prevent enrollment; the marker binds the concrete
+    directory identity and reset only accepts already enrolled profiles.
+    """
+    root_check(data, raw_data)
+    if data.exists():
+        private_directory(data)
+    else:
+        data.mkdir(parents=True, mode=0o700)
+    if (data / MARKER).exists() or (data / MARKER).is_symlink():
+        validate(data, raw_data, state, cache)
+        return
+    if any(path.name not in {"state", "cache", "engine"} for path in data.iterdir()):
+        raise ProfileError("Refusing to initialize a profile containing unrelated files")
+    if state != data / "state" or cache != data / "cache":
+        raise ProfileError("Profile state and cache must be direct children of the private root")
+    for path in (state, cache):
+        if not path.exists():
+            path.mkdir(mode=0o700)
+        private_directory(path)
+    info = data.stat()
+    record = {"identity": IDENTITY, "schema": 1, "uid": os.getuid(),
+              "root": str(data), "device": info.st_dev, "inode": info.st_ino}
+    descriptor = os.open(data / MARKER, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+    with os.fdopen(descriptor, "w") as stream:
+        json.dump(record, stream)
+        stream.write("\n")
+        stream.flush()
+        os.fsync(stream.fileno())
+    validate(data, raw_data, state, cache)
