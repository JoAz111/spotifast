+                if (self.receiverRunning && !self.stopping) [NSApp terminate:nil];
+            });
+        };
+        NSError *error = nil;
+        self.frontend = frontend;
+        if (![frontend launchAndReturnError:&error]) {
+            self.frontend = nil;
+            [self stop:nil];
